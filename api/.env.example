# BookDress API Environment Configuration
# This file is used for local development (without Docker)
# Copy this file to .env and update the values as needed

# Application Configuration
NODE_ENV=development
BC_PORT=4002
BC_HTTPS=false
BC_PRIVATE_KEY=/etc/ssl/bookdress.key
BC_CERTIFICATE=/etc/ssl/bookdress.crt

# Database Configuration (Local MongoDB)
BC_DB_URI="mongodb://127.0.0.1:27017/bookdress"
BC_DB_SSL=false
BC_DB_SSL_CERT=/etc/ssl/bookdress.crt
BC_DB_SSL_CA=/etc/ssl/bookdress.ca.pem
BC_DB_DEBUG=false

# Security Configuration
BC_COOKIE_SECRET=local_dev_cookie_secret
BC_AUTH_COOKIE_DOMAIN=localhost
BC_JWT_SECRET=local_dev_jwt_secret
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400

# Email Configuration
BC_SMTP_HOST=smtp.sendgrid.net
BC_SMTP_PORT=587
BC_SMTP_USER=apikey
BC_SMTP_PASS="your_smtp_password"
BC_SMTP_FROM=no-reply@bookdress.com
# File Storage Configuration (Local paths)
BC_CDN_ROOT=./api/cdn
BC_CDN_USERS=./api/cdn/bookdress/users
BC_CDN_TEMP_USERS=./api/cdn/bookdress/temp/users
BC_CDN_DRESSES=./api/cdn/bookdress/dresses
BC_CDN_TEMP_DRESSES=./api/cdn/bookdress/temp/dresses
BC_CDN_LOCATIONS=./api/cdn/bookdress/locations
BC_CDN_TEMP_LOCATIONS=./api/cdn/bookdress/temp/locations
BC_CDN_CONTRACTS=./api/cdn/bookdress/contracts
BC_CDN_TEMP_CONTRACTS=./api/cdn/bookdress/temp/contracts
BC_CDN_LICENSES=./api/cdn/bookdress/licenses
BC_CDN_TEMP_LICENSES=./api/cdn/bookdress/temp/licenses

# Application Settings
BC_DEFAULT_LANGUAGE=ar
BC_BACKEND_HOST=http://localhost:3001/
BC_FRONTEND_HOST=http://localhost:3000/
BC_WEBSITE_NAME=BookDress
BC_TIMEZONE=Asia/Jerusalem
BC_IPINFO_DEFAULT_COUNTRY=PS
BC_ADMIN_EMAIL=admin@bookdress.com

# External Services Configuration (for local testing)
BC_EXPO_ACCESS_TOKEN=your_expo_token
BC_STRIPE_SECRET_KEY=your_stripe_secret_key
BC_STRIPE_SESSION_EXPIRE_AT=82800
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=your_paypal_client_id
BC_PAYPAL_CLIENT_SECRET=your_paypal_client_secret
BC_RECAPTCHA_SECRET=your_recaptcha_secret
BC_IPINFO_API_KEY=your_ipinfo_api_key
