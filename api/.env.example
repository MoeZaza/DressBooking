# BookDress API Environment Configuration
# This file is used for local development (without Docker)
# Copy this file to .env and update the values as needed
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit .env files to version control
# 2. Use strong, unique secrets for production (minimum 32 characters)
# 3. Rotate secrets regularly
# 4. Use different values for development and production
# 5. Enable authentication in production (set BC_DISABLE_AUTH_IN_DEV=false)

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
BC_PORT=4002
BC_HTTPS=false
BC_PRIVATE_KEY=/etc/ssl/bookdress.key
BC_CERTIFICATE=/etc/ssl/bookdress.crt

# Disable authentication in development (ONLY for local development!)
# WARNING: NEVER set to true in production!
BC_DISABLE_AUTH_IN_DEV=true

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# For production, use MongoDB Atlas with SSL enabled
# Format: mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
BC_DB_URI="mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/bookdress?retryWrites=true&w=majority"
BC_DB_SSL=true
BC_DB_SSL_CERT=/etc/ssl/bookdress.crt
BC_DB_SSL_CA=/etc/ssl/bookdress.ca.pem
BC_DB_DEBUG=false

# ===========================================
# SECURITY CONFIGURATION (CRITICAL)
# ===========================================
# Generate strong secrets using: openssl rand -base64 32
# Minimum 32 characters recommended for production
BC_COOKIE_SECRET=CHANGE_THIS_to_a_strong_random_string_min_32_chars
BC_AUTH_COOKIE_DOMAIN=localhost
BC_JWT_SECRET=CHANGE_THIS_to_a_strong_random_string_min_32_chars
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400

# ===========================================
# DATABASE SECURITY SETTINGS
# ===========================================
# Enable database security features (recommended: true)
BC_ENABLE_DATABASE_SECURITY=true
BC_DB_QUERY_SANITIZATION=true
BC_DB_AUDIT_LOGGING=true
BC_DB_FIELD_ENCRYPTION=true

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
BC_SMTP_HOST=smtp.sendgrid.net
BC_SMTP_PORT=587
BC_SMTP_USER=apikey
BC_SMTP_PASS="your_smtp_password"
BC_SMTP_FROM=no-reply@bookdress.com

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# For local development, use relative paths
# For production, use absolute paths or cloud storage
BC_CDN_ROOT=./api/cdn
BC_CDN_USERS=./api/cdn/bookdress/users
BC_CDN_TEMP_USERS=./api/cdn/bookdress/temp/users
BC_CDN_DRESSES=./api/cdn/bookdress/dresses
BC_CDN_TEMP_DRESSES=./api/cdn/bookdress/temp/dresses
BC_CDN_LOCATIONS=./api/cdn/bookdress/locations
BC_CDN_TEMP_LOCATIONS=./api/cdn/bookdress/temp/locations
BC_CDN_CONTRACTS=./api/cdn/bookdress/contracts
BC_CDN_TEMP_CONTRACTS=./api/cdn/bookdress/temp/contracts
BC_CDN_LICENSES=./api/cdn/bookdress/licenses
BC_CDN_TEMP_LICENSES=./api/cdn/bookdress/temp/licenses

# ===========================================
# APPLICATION SETTINGS
# ===========================================
BC_DEFAULT_LANGUAGE=ar
BC_BACKEND_HOST=http://localhost:3001/
BC_FRONTEND_HOST=http://localhost:3000/
BC_WEBSITE_NAME=BookDress
BC_TIMEZONE=Asia/Jerusalem
BC_IPINFO_DEFAULT_COUNTRY=PS
BC_ADMIN_EMAIL=admin@bookdress.com

# ===========================================
# EXTERNAL SERVICES CONFIGURATION
# ===========================================
# Expo for push notifications
BC_EXPO_ACCESS_TOKEN=your_expo_token

# Stripe payment gateway
BC_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
BC_STRIPE_SESSION_EXPIRE_AT=82800

# PayPal payment gateway
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=your_paypal_client_id
BC_PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Google reCAPTCHA v3
BC_RECAPTCHA_SECRET=your_recaptcha_secret_key

# IPInfo.io for geolocation (optional)
BC_IPINFO_API_KEY=your_ipinfo_api_key

# ===========================================
# SECURITY RATE LIMITING
# ===========================================
# Rate limiting configuration to prevent abuse
BC_RATE_LIMIT_WINDOW_MS=900000
BC_RATE_LIMIT_MAX_REQUESTS=100
BC_AUTH_RATE_LIMIT_MAX=5
BC_PAYMENT_RATE_LIMIT_MAX=10

# ===========================================
# CONTENT SECURITY POLICY
# ===========================================
BC_CSP_REPORT_ONLY=false
BC_HSTS_MAX_AGE=31536000
BC_HSTS_INCLUDE_SUBDOMAINS=true
BC_HSTS_PRELOAD=true

# ===========================================
# DEVELOPMENT OPTIONS
# ===========================================
# Only for development - disables certain security features
# WARNING: NEVER enable these in production!
BC_ENABLE_SECURITY_LOGGING=true
BC_ENABLE_THREAT_DETECTION=false
BC_BLOCK_SUSPICIOUS_REQUESTS=false
BC_ENABLE_IP_BLOCKING=false

