# BookDress API Environment Configuration
# This file is used for Docker deployments (both development and production)
# Environment-specific values are overridden by Docker Compose environment variables

# Application Configuration
# NODE_ENV is overridden by Docker Compose (development/production)
NODE_ENV=production
BC_PORT=4002
BC_HTTPS=false
BC_PRIVATE_KEY=/etc/ssl/bookdress.key
BC_CERTIFICATE=/etc/ssl/bookdress.crt

# Database Configuration (MongoDB Atlas) - Default fallback
BC_DB_URI="mongodb+srv://user:Mybookmodr100@cluster0.ey9u2ce.mongodb.net/bookdress?retryWrites=true&w=majority&appName=Cluster0"
BC_DB_SSL=false
BC_DB_SSL_CERT=/etc/ssl/bookdress.crt
BC_DB_SSL_CA=/etc/ssl/bookdress.ca.pem
BC_DB_DEBUG=false

# Security Configuration
BC_COOKIE_SECRET=dev_cookie_secret_change_in_production
BC_AUTH_COOKIE_DOMAIN=localhost
BC_JWT_SECRET=dev_jwt_secret_change_in_production
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400

# Email Configuration
BC_SMTP_HOST=smtp.sendgrid.net
BC_SMTP_PORT=587
BC_SMTP_USER=apikey
BC_SMTP_PASS="your_smtp_password_here"
BC_SMTP_FROM=no-reply@bookdress.com
# File Storage Configuration
BC_CDN_ROOT=/var/www/cdn
BC_CDN_USERS=/var/www/cdn/bookdress/users
BC_CDN_TEMP_USERS=/var/www/cdn/bookdress/temp/users
BC_CDN_DRESSES=/var/www/cdn/bookdress/dresses
BC_CDN_TEMP_DRESSES=/var/www/cdn/bookdress/temp/dresses
BC_CDN_LOCATIONS=/var/www/cdn/bookdress/locations
BC_CDN_TEMP_LOCATIONS=/var/www/cdn/bookdress/temp/locations
BC_CDN_CONTRACTS=/var/www/cdn/bookdress/contracts
BC_CDN_TEMP_CONTRACTS=/var/www/cdn/bookdress/temp/contracts
BC_CDN_LICENSES=/var/www/cdn/bookdress/licenses
BC_CDN_TEMP_LICENSES=/var/www/cdn/bookdress/temp/licenses

# Application Settings
BC_DEFAULT_LANGUAGE=ar
BC_BACKEND_HOST=http://localhost:3001/
BC_FRONTEND_HOST=http://localhost:3000/
BC_WEBSITE_NAME=BookDress
BC_TIMEZONE=Asia/Jerusalem
BC_IPINFO_DEFAULT_COUNTRY=PS
BC_ADMIN_EMAIL=admin@bookdress.com

# External Services Configuration
BC_EXPO_ACCESS_TOKEN=your_expo_token_here
BC_STRIPE_SECRET_KEY=your_stripe_secret_key_here
BC_STRIPE_SESSION_EXPIRE_AT=82800
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
BC_PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
BC_RECAPTCHA_SECRET=your_recaptcha_secret_here
BC_IPINFO_API_KEY=your_ipinfo_api_key_here
