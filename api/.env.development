# BookDress API Development Environment Configuration
# This file contains development-specific settings that override defaults

# Environment
NODE_ENV=development

# Server Configuration
BC_PORT=3002

# Security Configuration - Development Mode
BC_ENABLE_SECURITY_LOGGING=true
BC_ENABLE_THREAT_DETECTION=false
BC_BLOCK_SUSPICIOUS_REQUESTS=false
BC_ENABLE_IP_BLOCKING=false
BC_IP_BLOCK_THRESHOLD=1000
BC_ADMIN_IP_WHITELIST=

# Rate Limiting - Relaxed for Development
BC_RATE_LIMIT_WINDOW_MS=60000
BC_RATE_LIMIT_MAX_REQUESTS=1000
BC_AUTH_RATE_LIMIT_MAX=50
BC_PAYMENT_RATE_LIMIT_MAX=100

# CORS - Allow all localhost origins in development
BC_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4002

# CSP - Report only in development
BC_CSP_REPORT_ONLY=true

# HSTS - Disabled in development
BC_HSTS_MAX_AGE=0
BC_HSTS_INCLUDE_SUBDOMAINS=false
BC_HSTS_PRELOAD=false

# Development URLs
BC_FRONTEND_HOST=http://localhost:3000
BC_BACKEND_HOST=http://localhost:3001

# Logging
LOG_LEVEL=debug
