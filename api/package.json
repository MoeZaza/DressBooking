{
  "name": "api",
  "version": "7.2.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" tsc --build --verbose && babel dist -d dist",
    "start": "npm run build && node dist/src",
    "test": "rimraf coverage && npm run build && cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --no-cache",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "ncu": "ncu -u",
    "db:create": "tsx src/scripts/init-default-data.ts create",
    "db:create:prod": "npm run build && node dist/src/scripts/init-default-data.js create",
    "db:init": "tsx src/scripts/init-default-data.ts init",
    "db:init:prod": "npm run build && node dist/src/scripts/init-default-data.js init",
    "db:atlas:init": "tsx src/scripts/atlas-init.ts",
    "db:atlas:complete": "tsx src/scripts/atlas-complete-init.ts",
    "db:migrate": "tsx src/scripts/init-default-data.ts migrate",
    "db:migrate:prod": "npm run build && node dist/src/scripts/init-default-data.js migrate",
    "db:init:admin": "tsx src/scripts/init-default-data.ts admin",
    "db:init:data": "tsx src/scripts/init-default-data.ts data",
    "db:init:settings": "tsx src/scripts/init-default-data.ts settings",
    "db:init:language": "tsx src/scripts/init-default-data.ts language",
    "db:init:indexes": "tsx src/scripts/init-default-data.ts indexes",
    "db:validate": "tsx src/scripts/dataValidationCleanup.ts validate",
    "db:validate:fix": "tsx src/scripts/dataValidationCleanup.ts validate --fix",
    "db:test-safety": "tsx src/scripts/test-database-safety.ts",
    "analytics:generate": "tsx src/scripts/generateMonthlyAnalytics.ts",
    "analytics:generate:prod": "npm run build && node dist/src/scripts/generateMonthlyAnalytics.js",
    "docs:generate": "tsx src/scripts/generateApiDocs.ts",
    "docs:validate": "tsx src/scripts/validateApiDocs.ts",
    "docs:serve": "npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
