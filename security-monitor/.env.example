# BookDress Security Monitor Configuration

# Server Configuration
NODE_ENV=development
PORT=4002

# Security Configuration
SECURITY_LEVEL=standard
ENABLE_REAL_TIME_MONITORING=true
LOG_LEVEL=debug

# Alert Thresholds
ALERT_THRESHOLD_CRITICAL=10
ALERT_THRESHOLD_HIGH=50
ALERT_THRESHOLD_MEDIUM=100

# Data Retention
DATA_RETENTION_DAYS=7
MAX_INCIDENTS=1000
MAX_ALERTS=100

# Service URLs (for development)
API_URL=http://localhost:4002
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4002

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=25000
WEBSOCKET_PING_TIMEOUT=5000

# Monitoring Intervals (in seconds)
HEALTH_CHECK_INTERVAL=30
METRICS_FETCH_INTERVAL=120
INCIDENTS_FETCH_INTERVAL=60
CLEANUP_INTERVAL=21600

# Development Settings
ENABLE_DEBUG_LOGS=true
ENABLE_MOCK_DATA=false
ENABLE_TEST_ENDPOINTS=true
