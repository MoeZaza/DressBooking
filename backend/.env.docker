# BookDress Backend (Admin Dashboard) Environment Configuration
# This file is used for Docker deployments (both development and production)

# Application Configuration
# NODE_ENV is overridden by Docker Compose (development/production)
VITE_NODE_ENV=production
VITE_BC_API_HOST=http://localhost:4002
VITE_BC_DEFAULT_LANGUAGE=ar
# Pagination Configuration
VITE_BC_PAGE_SIZE=30
VITE_BC_DRESSES_PAGE_SIZE=15
VITE_BC_BOOKINGS_PAGE_SIZE=20
# CDN Configuration
VITE_BC_CDN_USERS=http://localhost:4002/cdn/bookdress/users
VITE_BC_CDN_TEMP_USERS=http://localhost:4002/cdn/bookdress/temp/users
VITE_BC_CDN_DRESSES=http://localhost:4002/cdn/bookdress/dresses
VITE_BC_CDN_TEMP_DRESSES=http://localhost:4002/cdn/bookdress/temp/dresses
VITE_BC_CDN_LOCATIONS=http://localhost:4002/cdn/bookdress/locations
VITE_BC_CDN_TEMP_LOCATIONS=http://localhost:4002/cdn/bookdress/temp/locations
VITE_BC_CDN_CONTRACTS=http://localhost:4002/cdn/bookdress/contracts
VITE_BC_CDN_TEMP_CONTRACTS=http://localhost:4002/cdn/bookdress/temp/contracts
VITE_BC_CDN_LICENSES=http://localhost:4002/cdn/bookdress/licenses
VITE_BC_CDN_TEMP_LICENSES=http://localhost:4002/cdn/bookdress/temp/licenses
# Image Configuration
VITE_BC_SUPPLIER_IMAGE_WIDTH=60
VITE_BC_SUPPLIER_IMAGE_HEIGHT=30
VITE_BC_DRESS_IMAGE_WIDTH=300
VITE_BC_DRESS_IMAGE_HEIGHT=200

# UI Configuration
VITE_BC_PAGINATION_MODE=classic
VITE_BC_CURRENCY=₪
VITE_BC_DEPOSIT_FILTER_VALUE_1=250
VITE_BC_DEPOSIT_FILTER_VALUE_2=500
VITE_BC_DEPOSIT_FILTER_VALUE_3=750

# Application Settings
VITE_BC_WEBSITE_NAME=BookDress
VITE_BC_CONTACT_EMAIL=info@bookdress.com
VITE_BC_RECAPTCHA_ENABLED=false
VITE_BC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Development Server Configuration (Docker)
VITE_PORT=3001
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3001
VITE_HMR_CLIENT_PORT=3001
